{
  "dataset": "premier_league_team_names",
  "schema_version": 1,
  "researched_on": "2026-09-23",
  "scope": {
    "competition": "English Premier League",
    "from_season": "1992-93",
    "through_season": "2026-27",
    "through_season_status": "in progress",
    "club_count": 51,
    "identity_rule": "Include each distinct club that has played at least one Premier League season since the inaugural 1992-93 season. Use the historical Premier League identity where a club later relocated, dissolved, or has a successor."
  },
  "canonical_name_policy": "canonical_name is the single concise display name to use for this project. It is an entity label, not necessarily the club's complete registered name. For example, Hull City is represented as Hull, while Manchester City and Manchester United retain their distinguishing city names.",
  "alias_methodology": "The club universe comes from the all-time Premier League club list. Aliases are curated from official/full club-name forms, common short forms, and shortened team labels observed in football-data.co.uk season CSVs. This is a practical exact-match dictionary, not a generator for arbitrary typos; add new forms after review.",
  "matching_guidance": {
    "match_canonical_names_as_aliases": true,
    "case_insensitive": true,
    "recommended_normalization": [
      "Apply Unicode NFKC normalization and case-fold text.",
      "Trim leading and trailing whitespace and collapse repeated internal whitespace.",
      "Treat straight and curly apostrophes consistently; ignore periods used in abbreviations such as F.C. and Utd.",
      "Treat '&' and 'and' as equivalent when comparing names.",
      "Compare the whole normalized name, not a substring."
    ],
    "do_not_auto_fuzzy_match": "Do not guess an unmapped or misspelled name with edit distance alone. Send unknown values and ambiguous short tokens for review.",
    "deliberately_not_aliases": [
      "Generic words such as City, United, FC, and Blues are not safe standalone aliases.",
      "Ambiguous nicknames and generic words are omitted from automatic matching; listed short forms are intended in Premier League context.",
      "AFC Wimbledon and Milton Keynes Dons are not aliases for Wimbledon, the historic Premier League participant."
    ]
  },
  "sources": [
