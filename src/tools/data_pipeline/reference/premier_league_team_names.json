    },
    {
      "id": "football_data_season_index",
      "url": "https://www.football-data.co.uk/englandm.php",
      "supports": "Provides links to Premier League results CSVs by season, including historical and current seasons; the CSV HomeTeam and AwayTeam fields demonstrate real-world shortened name forms."
    },
